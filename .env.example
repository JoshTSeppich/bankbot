# The discovery loop is the only place the system talks to a model. Replay
# never reads this file. Copy to .env (gitignored); python-dotenv loads it.

# Anthropic key for the Claude Messages API (vision + tool use).
ANTHROPIC_API_KEY=

# Only needed when ANTHROPIC_API_KEY is org-scoped rather than scoped to one
# workspace. A workspace-scoped key does not need this. Leave blank otherwise.
ANTHROPIC_WORKSPACE_ID=

# Credentials the demo bank app accepts. Replay resolves SecretRefs from these
# by name at run time; the values never enter an artifact or a log.
BANKBOT_USERNAME=teller
BANKBOT_PASSWORD=teller-demo-password
